# Copy this file to ".env" and fill in the values below, then restart the
# server. Neither notification is required for the site to run - if a key
# is missing, that notification is just skipped (a warning is logged).

# --- Email notifications (via Resend, https://resend.com) ---
# 1. Sign up for a free Resend account.
# 2. Create an API key at https://resend.com/api-keys
# 3. Paste it here:
RESEND_API_KEY=

# Optional: once you verify your own domain on Resend, you can send from
# your own address instead of the shared onboarding@resend.dev sender.
# RESEND_FROM=Dhanishka Aqua Systems <notifications@yourdomain.com>

# --- WhatsApp notifications (via CallMeBot, https://www.callmebot.com/blog/free-api-whatsapp-messages/) ---
# 1. Save this number in your phone contacts: +34 644 44 88 96
# 2. Send this exact message to it on WhatsApp: "I allow callmebot to send me messages"
# 3. CallMeBot will reply with your personal apikey. Paste it here:
CALLMEBOT_API_KEY=

# The WhatsApp number that should receive the alerts (with country code,
# no + or spaces). Defaults to 919942266932 if left blank.
CALLMEBOT_PHONE=919942266932

# --- Admin panel ---------------------------------------------------------
# REQUIRED before going live. Pick a long, unique password. (The old
# built-in default stops working when NODE_ENV=production.)
ADMIN_PASSWORD=
# Optional: a long random string used to sign admin login sessions. If left
# blank a new one is generated on every restart (admins just log in again).
# ADMIN_TOKEN_SECRET=

# --- AI assistant ("Aqua Assistant" chat on every page) --------------------
# Create a key at https://console.anthropic.com/ . The key stays on the
# server and is never exposed to visitors. Without it the chat widget still
# works, but replies with your phone/WhatsApp details instead of AI answers.
ANTHROPIC_API_KEY=
# Optional: choose a different model (default is a fast, low-cost one).
# ANTHROPIC_MODEL=claude-haiku-5-5
